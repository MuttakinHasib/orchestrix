APP_ENV=development
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=30s

DATABASE_URL=postgres://orchestrix:orchestrix@localhost:5432/orchestrix?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2

REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=debug
LOG_FORMAT=json

JWT_ACCESS_SECRET=change-me-min-32-bytes-please-abcdefg
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318